doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title My Portfolio
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css")
    link(rel="stylesheet", href="/css/styles.css")      
  body.d-flex.flex-column.min-vh-100
    header#header.navbar.navbar-expand-lg.navbar-dark.bg-dark.py-3
      .container
        a.navbar-brand.fs-3.fw-bold(href="/") 
          i.bi.bi-person-circle.me-2
          | My Portfolio
        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarNav")
          span.navbar-toggler-icon
        .collapse.navbar-collapse#navbarNav
          ul.navbar-nav.ms-auto
            li.nav-item
              a.nav-link.fs-5(href="/")
                i.bi.bi-house-door.me-1
                | Home
            li.nav-item
              a.nav-link.fs-5(href="/admin/skill")
                i.bi.bi-lightbulb.me-1
                | Skills
            li.nav-item
              a.nav-link.fs-5(href="/admin/project")
                i.bi.bi-folder-fill.me-1
                | Projects
            li.nav-item
              a.nav-link.fs-5(href="/contact")
                i.bi.bi-envelope.me-1
                | Contact
    main.container.mt-5.flex-grow-1.mb-4
      block layout-content
    footer#footer.bg-dark.text-white.text-center.py-3.mt-auto.w-100
      | &copy; All rights reserved 2025 | Designed by Mohith

    // Bootstrap JS for navbar toggling
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")