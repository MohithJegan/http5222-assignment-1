extends ./layout

block layout-content
  .container.py-5
    .text-center.mb-4
      h1.fw-bold Contact Me
      p.fs-5.text-muted If you have questions, feedback, or just want to say hello, feel free to reach out. I’m here to assist you with any inquiries you may have regarding my work or collaborations.
    .row.g-4
      .col-md-6.col-lg-6.d-flex
        .card.shadow-sm.p-4.h-100.w-100
          h3.fw-bold.mb-3 Contact Information
          ul.list-unstyled.mb-0
            li.mb-2
              strong Name: 
              | Mohith Krishnamoorthy Jeganathan
            li.mb-2
              strong Email: 
              | abc@email.com
            li.mb-2
              strong Phone Number: 
              | (123)-456-789
      .col-md-6.col-lg-6.d-flex
        .card.shadow-sm.p-4.h-100.w-100
          h3.fw-bold.mb-3 Social Media
          ul.mb-0
            li.mb-2: a.text-decoration-none(href='#') LinkedIn
            li.mb-2: a.text-decoration-none(href='#') Instagram
            li.mb-2: a.text-decoration-none(href='#') Facebook
            li.mb-2: a.text-decoration-none(href='#') Discord
            li.mb-2: a.text-decoration-none(href='#') GitHub
    .row.g-4.mt-2
      .col-md-6.col-lg-6.d-flex
        .card.shadow-sm.p-4.h-100.w-100
          h3.fw-bold.mb-3 Method of Contact
          ul.mb-0
            li.mb-2 Email
            li.mb-2 Phone
            li.mb-2 Text Message
      .col-md-6.col-lg-6.d-flex
        .card.shadow-sm.p-4.h-100.w-100
          h3.fw-bold.mb-3 Location
          address
            p.mb-1 123 Main Street,
            p.mb-1 Toronto, Ontario,
            p.mb-0 M9W 9M9
